rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 👤 유저 개인 게임 데이터 (컬렉션, 코인, 업적, 쿠폰 이력 등)
    match /nmixx_tcg_users/{userId} {
      // 본인의 UID인 경우에만 완전한 읽기 및 쓰기 허용
      allow read, write: if request.auth != null;
    }

    // 🏆 글로벌 리더보드 (모든 유저 랭킹)
    match /nmixx_tcg_leaderboard/{userId} {
      // 모든 사용자가 랭킹 열람 가능
      allow read: if true;
      // 본인의 랭킹 점수만 업데이트 가능
      allow write: if request.auth != null;
    }

    // 🔄 1:1 카드 교환소 (Marketplace)
    match /nmixx_tcg_market/{tradeId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // 🌟 글로벌 카드 획득 실시간 피드
    match /nmixx_tcg_feed/{feedId} {
      allow read: if true;
      allow create: if request.auth != null;
    }
  }
}
