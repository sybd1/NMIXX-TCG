# ==============================================================================
# NMIXX TCG - 환경 변수 설정 템플릿 (.env.example)
# ==============================================================================
# Vercel 및 로컬 환경에서 필요한 환경 변수 목록입니다.
# 실제 프로덕션 키는 Vercel 대시보드 (Settings > Environment Variables)에 등록하세요.

# [Firebase Web Client Configuration]
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=nmixx-tcg.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=nmixx-tcg
VITE_FIREBASE_STORAGE_BUCKET=nmixx-tcg.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here

# [Kakao JavaScript SDK Key]
VITE_KAKAO_JS_KEY=your_kakao_javascript_key_here
